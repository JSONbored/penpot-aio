#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

source /usr/local/bin/env-helpers.sh
load_runtime_env

if env_flag_is_false "${PENPOT_AIO_ENABLE_MCP:-true}"; then
	log "Bundled MCP disabled. MCP service staying idle."
	exec sleep infinity
fi

mkdir -p "${PENPOT_MCP_LOG_DIR:-/appdata/logs/mcp}"
chown -R penpot:penpot "${PENPOT_MCP_LOG_DIR:-/appdata/logs/mcp}"

export HOME="/opt/penpot"
export USER="penpot"
export LOGNAME="penpot"
export PATH="/command:/opt/node-mcp/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

cd /opt/penpot/mcp
exec /command/s6-setuidgid penpot /opt/node-mcp/bin/node index.js --multi-user
