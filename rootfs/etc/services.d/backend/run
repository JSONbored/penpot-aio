#!/command/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

source /usr/local/bin/env-helpers.sh
load_runtime_env

wait_for_postgres_ready
wait_for_redis_ready
wait_for_mailpit_ready

export HOME="/opt/penpot"
export USER="penpot"
export LOGNAME="penpot"
export PATH="/command:/opt/jre/bin:/opt/node/bin:/opt/imagick/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

cd /opt/penpot/backend
exec /command/s6-setuidgid penpot ./run.sh
